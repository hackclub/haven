      "display_name": "Haven (dev)",
      "always_online": false
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "channels:read",
        "channels:history",
        "channels:join",
        "channels:write.invites",
        "chat:write",
        "chat:write.customize",
        "groups:history",
        "groups:write.invites",
        "reactions:read",
        "reactions:write",
        "users:read",
        "users:read.email",
        "groups:read"
      ]
    },
    "pkce_enabled": false
  },
  "settings": {
    "event_subscriptions": {
      "request_url": "https://haven.jollyy.dev/api/slack/events",
      "bot_events": ["message.channels", "message.groups"]
    },
    "interactivity": {
      "is_enabled": true,
      "request_url": "https://haven.jollyy.dev/api/slack/events"
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false,
    "is_mcp_enabled": false
