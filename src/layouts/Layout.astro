---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Haven — Organize a game jam in your city!",
  description = "Haven is a Hack Club event for teenagers to organize their own game jam. Nov 14–15, for teenagers around the world.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />

    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />

    {/* Fonts via <link> rather than an @import inside the stylesheet, so the
        font request starts alongside the CSS instead of after it parses. */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Darumadrop+One&family=Jua&display=swap"
    />

    <!-- Privacy-friendly analytics by Plausible -->
    <script async src="https://plausible.io/js/pa-NOfzi3QD0QvG1dD-VNMuv.js"
    ></script>
    <script>
      // @ts-nocheck
      ((window.plausible =
        window.plausible ||
        function () {
          (plausible.q = plausible.q || []).push(arguments);
        }),
        (plausible.init =
          plausible.init ||
          function (i) {
            plausible.o = i || {};
          }));
      plausible.init();
    </script>
  </head>

  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded-2xl focus:bg-white focus:px-4 focus:py-2 focus:font-display focus:text-xl focus:text-haven-orange-deep"
    >
      Skip to content
    </a>
    <slot />
  </body>
</html>
