---
import "../styles/global.css";

interface Props {
  title?: string;
}

const { title = "Haven — Lead a hackathon in your city!" } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content="Haven is a Hack Club event for teenagers to learn how to lead their own hackathon. Nov 14-15, for teenagers around the world."
    />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
