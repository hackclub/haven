---
import Layout from "../layouts/Layout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import Hero from "../components/Hero.astro";
import About from "../components/About.astro";
import Pitch from "../components/Pitch.astro";
import Steps from "../components/Steps.astro";
import PastEvents from "../components/PastEvents.astro";
import Sponsors from "../components/Sponsors.astro";
import Faq from "../components/Faq.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { supporters, supportersHeading } from "../data/content";
---

<Layout>
  <SiteHeader />

  <main id="main">
    <Hero />

    <div id="about" class="stage stage-middle">
      <About />
      <Pitch />
    </div>

    <Steps />

    <div class="stage stage-picnic">
      <PastEvents />
    </div>

    <Sponsors heading={supportersHeading} items={supporters} />

    <Faq />
  </main>

  <SiteFooter />
</Layout>
