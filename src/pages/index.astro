---
import Layout from "../layouts/Layout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import Hero from "../components/Hero.astro";
import About from "../components/About.astro";
import Pitch from "../components/Pitch.astro";
import Steps from "../components/Steps.astro";
import PastEvents from "../components/PastEvents.astro";
import Faq from "../components/Faq.astro";
import SiteFooter from "../components/SiteFooter.astro";
import Sponsors from "../components/Sponsors.astro";
import Schedule from "../components/Schedule.astro";
import { supporters, supportersHeading } from "../data/content";
import { schedule, scheduleHeading } from "../data/content";
---

<Layout>
  <SiteHeader />

  <main id="main" class="overflow-x-clip">
    <div class="relative z-20"><Hero /></div>

    <div id="about" class="relative stage stage-middle z-10">
      <About />
      <Pitch />
    </div>

    <div class="relative z-10 flex justify-center">
      <img
        src="/images/flower-border.webp"
        alt=""
        aria-hidden="true"
        width="3586"
        height="819"
        class="pointer-events-none absolute left-1/2 top-0 -translate-x-1/2 -translate-y-1/2 object-cover md:hidden"
      />
    </div>

    <div class="z-0">
      <Steps />
    </div>

    <div class="stage stage-picnic">
      <PastEvents />
    </div>

    {
    <Sponsors heading={supportersHeading} items={supporters} />
    <Schedule heading={scheduleHeading} days={schedule} />
    }

    <Faq />
  </main>

  <SiteFooter />
</Layout>
