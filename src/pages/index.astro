---
import Layout from "../layouts/Layout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import Hero from "../components/Hero.astro";
import About from "../components/About.astro";
import Pitch from "../components/Pitch.astro";
import Steps from "../components/Steps.astro";
import PastEvents from "../components/PastEvents.astro";
import Faq from "../components/Faq.astro";
import SiteFooter from "../components/SiteFooter.astro";
import Sponsors from "../components/Sponsors.astro";
import Schedule from "../components/Schedule.astro";
import { supporters, supportersHeading } from "../data/content";
import { schedule, scheduleHeading } from "../data/content";

const isPoc = true;
---

<Layout>
  <SiteHeader />

  <main id="main" class="overflow-x-clip">
    <div class="relative z-20"><Hero poc={isPoc} /></div>

    <div id="about" class="relative stage stage-middle z-10">
      <About />
      <Pitch poc={isPoc} />
    </div>

    <div class="relative z-0">
      <Steps poc={isPoc} />
    </div>

    <div class="relative z-10">
      <Schedule heading={scheduleHeading} days={schedule} />
    </div>

    <div class="stage stage-picnic">
      <PastEvents />
    </div>

    <Sponsors heading={supportersHeading} items={supporters} />

    <Faq />
  </main>

  <SiteFooter />
</Layout>
