---
import Layout from "../layouts/Layout.astro";
import ScaledCanvas from "../components/ScaledCanvas.astro";
import DesktopScene from "../components/DesktopScene.astro";
import MobileScene from "../components/MobileScene.astro";
import MobileExtra from "../components/MobileExtra.astro";
---

<Layout>
  <div class="hidden md:block">
    <ScaledCanvas width={1440} height={5340}>
      <DesktopScene />
    </ScaledCanvas>
  </div>

  <div class="md:hidden">
    <ScaledCanvas width={402} height={2862}>
      <MobileScene />
    </ScaledCanvas>
    <MobileExtra />
  </div>
</Layout>
