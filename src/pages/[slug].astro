---
import Layout from "../layouts/Layout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import Hero from "../components/Hero.astro";
import About from "../components/About.astro";
import Pitch from "../components/Pitch.astro";
import Schedule from "../components/Schedule.astro";
import Steps from "../components/Steps.astro";
import PastEvents from "../components/PastEvents.astro";
import Sponsors from "../components/Sponsors.astro";
import Faq from "../components/Faq.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { event } from "../data/content";
import { resolveSiteData } from "../data/site";
import { getDataForSlug } from "../lib/services/websites";

const slug = Astro.params.slug!;

const data = await getDataForSlug(slug);

if (!data) {
  return new Response(null, { status: 404, statusText: "Not found" });
}

const site = resolveSiteData(data);

const pageTitle = `${event.name} — ${site.title.join(" ")}`;
---

<Layout title={pageTitle}>
  <SiteHeader />

  <main id="main" class="overflow-x-clip">
    <div class="relative z-20">
      <Hero title={site.title} tagline={site.tagline} poc={false} />
    </div>

    <div id="about" class="stage stage-middle z-10">
      <About />
      <Pitch poc={false} />
    </div>

    <div class="z-0">
      <Steps poc={false} />
    </div>

    <Schedule heading={site.schedule.heading} days={site.schedule.days} />

    <div class="stage stage-picnic">
      <PastEvents />
    </div>

    <Sponsors heading={site.sponsors.heading} items={site.sponsors.items} />

    <Faq items={site.faq} />
  </main>

  <SiteFooter />
</Layout>
