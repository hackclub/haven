---
import { navLinks } from "../data/content";
---

<header class="absolute inset-x-0 top-0 z-30">
  {/* The nav sits on this blob, so it can't shrink at the same rate as the
      viewport: the paint only turns opaque ~6% in from the left edge and pulls
      further right down the shape, so a straight 46% left the links hanging off
      the foliage on every phone width. The extra rem term flattens the curve
      below ~550px, where the nav's own type and gaps stop scaling too. */}
  <img
    src="/images/nav-banner.webp"
    alt=""
    aria-hidden="true"
    width="646"
    height="260"
    class="pointer-events-none fixed right-0 top-0 -z-10 w-[min(41rem,max(46%,calc(13rem_+_8vw)))] max-w-none select-none md:right-[clamp(-3rem,-2vw,0rem)] md:top-[clamp(-3rem,-2vw,0rem)]"
  />

  <div
    class="shell relative flex items-start justify-end pb-3 pt-[clamp(0.5rem,1.4vw,1.5rem)]"
  >
    {/* Figma puts the lockup at y35 / 257px wide on a 1440 frame — 2.4vw down
        and 17.9vw across. Sized a touch above that so it holds its weight on
        mid-size screens. */}
    {/* Centred at every size, and positioned from the shared --logo-* box so it
        scales in place instead of stepping up at the breakpoint. The hero's top
        padding is derived from the same values, so it always sits clear of the
        headline. */}
    <a
      href="#top"
      class="absolute left-1/2 top-[var(--logo-top)] -translate-x-1/2"
      aria-label={`Hack Club Haven — home`}
    >
      <img
        src="/images/logo.webp"
        alt="Hack Club Haven"
        width="778"
        height="445"
        class="w-[var(--logo-w)]"
      />
    </a>

    {/* Figma sets these at 40px on a 1440 frame (2.78vw); they were running at
        1.9vw, which read as cramped from md up. */}
    <nav class="fixed" aria-label="Primary">
      <ul class="flex items-center gap-[clamp(1.125rem,2.2vw,2.75rem)]">
        {
          navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="inline-block py-1 font-display text-[clamp(1rem,3vw,2rem)] leading-none tracking-[-0.03em] text-haven-yellow transition-colors hover:text-white"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
