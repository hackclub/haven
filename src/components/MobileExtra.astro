---
// Not present in the mobile Figma frame (163:36 stops after the FAQ) — this is a
// responsive fallback so mobile visitors still get the video showcase + footer
// that exist in the desktop wireframe.
const videos = [
  {
    title: "Scrapyard",
    caption: "Build wacky stuff, get wacky prizes! In-person hackathon in 70+ cities.",
    image: "/images/scrapyard-pic.png",
    play: "/images/play-triangle-1.svg",
    href: "https://www.youtube.com/watch?v=8iM1W8kXrQA",
  },
  {
    title: "Daydream",
    caption: "Students led game jams in 100 cities worldwide, from London to NYC to Penang!",
    image: "/images/daydream-pic.png",
    play: "/images/play-triangle-2.svg",
    href: "https://www.youtube.com/watch?v=vvdoW2gh9YU",
  },
  {
    title: "Campfire",
    caption: "Our largest game jam yet: 10k teens, 1 weekend, making games at the same time!",
    image: "/images/scrapyard-pic-2.png",
    play: "/images/play-triangle-3.svg",
    objectPosition: "object-bottom",
    href: "https://www.youtube.com/watch?v=0aMAHuLxg3s",
  },
];
---

<section class="bg-[#ed5615] px-4 py-10 flex flex-col items-center gap-8 text-center">
  <p class="font-['Darumadrop_One'] text-white text-[1.4rem] leading-[0.9] tracking-[-0.03em] max-w-[26ch]">
    We&rsquo;ve helped teens organize hundreds of hackathons around the world! Check out some of our past
    events ~
  </p>

  <div class="flex flex-col gap-6 w-full items-center">
    {videos.map((v) => (
      <a
        href={v.href}
        target="_blank"
        rel="noopener"
        class="-rotate-2 bg-[#ed5615]/50 border-3 border-[#ffd059] rounded-[30px] shadow-[0_0_4px_#ffd059] w-full max-w-[280px] px-5 py-6 flex flex-col items-center gap-3"
      >
        <div class={`relative w-full aspect-[288/192] border-2 border-white rounded-[20px] overflow-hidden`}>
          <img src={v.image} alt={v.title} class={`w-full h-full object-cover ${v.objectPosition ?? ""}`} />
          <img src={v.play} alt="" class="absolute top-1/2 left-1/2 w-[30%] -translate-x-1/2 -translate-y-1/2 -rotate-40" />
        </div>
        <h3 class="font-['Darumadrop_One'] text-white text-[1.6rem] tracking-[-0.03em]">{v.title}</h3>
        <p class="font-['Jua'] text-white text-sm">{v.caption}</p>
      </a>
    ))}
  </div>
</section>

<footer class="bg-[#b8c220] px-6 py-10 flex flex-col gap-6 text-white">
  <div class="relative inline-flex items-end gap-1 self-start">
    <span class="block w-[160px] aspect-[232/87] overflow-hidden">
      <img src="/images/haven-logo.png" alt="Haven" class="w-full h-full object-cover" />
    </span>
    <img src="/images/flag.png" alt="" class="w-[60px] h-auto" />
  </div>

  <nav class="flex flex-wrap gap-x-6 gap-y-2">
    <span class="font-['Darumadrop_One'] text-2xl tracking-[-0.05em]">Hack Club</span>
    <span class="font-['Darumadrop_One'] text-2xl tracking-[-0.05em]">Slack</span>
    <span class="font-['Darumadrop_One'] text-2xl tracking-[-0.05em]">Clubs</span>
    <span class="font-['Darumadrop_One'] text-2xl tracking-[-0.05em]">Hackathons</span>
  </nav>

  <div class="font-['Jua'] text-sm leading-relaxed flex flex-col gap-4">
    <p>
      Hack Club is a 501(c)(3) nonprofit and network of 100k+ technical high schoolers. We believe
      you learn best by building, so we&rsquo;re creating community and providing grants so you can
      make awesome projects. In the past few years, we&rsquo;ve
      <a class="underline" href="https://www.youtube.com/watch?v=ufMUJ9D1fi8" target="_blank" rel="noopener">sent 30 teen hackers hiking the Pacific Crest Trail</a>,
      <a class="underline" href="https://www.youtube.com/watch?v=8iM1W8kXrQA" target="_blank" rel="noopener">hosted a hackathon for the worst ideas</a>, and
      <a class="underline" href="https://www.youtube.com/watch?v=kaEFv7e49mo" target="_blank" rel="noopener">ran the largest teen hardware hackathon at GitHub HQ</a>.
    </p>
    <p>
      Read about Hack Club in
      <a class="underline" href="https://www.wsj.com/articles/teen-hackers-try-to-convince-parents-they-are-up-to-good-11569922200" target="_blank" rel="noopener">The Wall Street Journal</a>,
      <a class="underline" href="https://www.cbsnews.com/sanfrancisco/news/hack-club-hosts-teen-coders-san-francisco/" target="_blank" rel="noopener">CBS News</a>, and
      <a class="underline" href="https://www.nasa.gov/learning-resources/space-out-this-summer-with-variety-of-nasa-stem-activities/" target="_blank" rel="noopener">NASA.gov</a>,
      or watch us
      <a class="underline" href="https://www.youtube.com/live/UbfAhFxDomE?si=5DiK1_hGqKrB_r50&t=7033" target="_blank" rel="noopener">on stage with AMD CEO Lisa Su at CES</a>.
    </p>
    <p>Made with &hearts; by teenagers, for teenagers at Hack Club</p>
  </div>
</footer>
