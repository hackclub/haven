---
interface Project {
  title: string;
  author: string;
  href: string;
  image: string;
}

const projects: Project[] = [
  {
    title: "return to the sender",
    author: "by i1rs7",
    href: "https://i1rs7.itch.io/return-to-the-sender",
    image: "/images/project-1.jpg",
  },
  {
    title: "deathleap",
    author: "by qrosp, juusaktmii, & 1100010101",
    href: "https://qrosp-games-oy.itch.io/deathleap",
    image: "/images/projects-2.jpg",
  },
  {
    title: "office click clack",
    author: "by bunnyguy",
    href: "https://theavgeekbee.itch.io/office-click-clack",
    image: "/images/projects-3.jpg",
  },
];

const friendsPhotos = ["/images/friends-1.jpg", "/images/friends-2.jpg", "/images/friends-3.jpg"];
const foodPhotos = ["/images/food-1.jpg", "/images/food-2.jpg", "/images/food-3.jpg"];
---

<section id="info" class="relative isolate overflow-hidden bg-haven-green py-[clamp(3rem,7vw,6rem)]">
  <img
    src="/images/haven-bg-middle.png"
    alt=""
    class="absolute inset-0 -z-10 h-full w-full object-cover object-top"
  />

  <div class="relative z-10 mx-auto flex w-full max-w-[75rem] flex-col px-[clamp(1.25rem,4vw,3rem)]">
    <div class="relative max-w-md">
      <h2 class="font-darumadrop text-[clamp(1.75rem,4vw,2.75rem)] leading-[0.8] tracking-tight text-white [text-shadow:0_0_8px_var(--color-haven-orange-deep)]">
        What is a game jam?
      </h2>
      <p class="mt-2 max-w-xs font-jua text-[clamp(0.85rem,1.6vw,1.15rem)] text-white [text-shadow:0_0_6px_var(--color-haven-orange-deep)]">
        It&rsquo;s a social coding event where you make a video game with friends + free food!
      </p>
      <img
        src="/images/daven-gif.png"
        alt=""
        class="absolute right-[-2rem] top-[-1.5rem] w-[clamp(3rem,6vw,5.5rem)] sm:right-[-3rem]"
      />
    </div>

    <div class="mt-[clamp(2.5rem,7vw,5rem)] flex flex-col gap-[clamp(1.5rem,4vw,2.5rem)]">
      <div class="w-full self-start sm:w-[26rem]">
        <div class="rounded-[2rem] border-2 border-haven-yellow p-[clamp(0.4rem,1vw,0.6rem)]">
          <div class="rounded-[1.6rem] bg-white/80 px-[clamp(1rem,2.5vw,1.5rem)] py-[clamp(1.25rem,3vw,1.75rem)]">
            <h3 class="text-center font-darumadrop text-[clamp(1.35rem,2.6vw,1.9rem)] leading-[0.8] tracking-tight text-haven-orange-mid">
              Learn and Build
            </h3>
            <div class="mt-3 grid grid-cols-3 gap-[clamp(0.4rem,1vw,0.6rem)]">
              {
                projects.map((project) => (
                  <a
                    href={project.href}
                    target="_blank"
                    rel="noreferrer"
                    class="block overflow-hidden rounded-[0.9rem] transition-transform hover:scale-[1.04]"
                  >
                    <img src={project.image} alt={project.title} class="aspect-[4/3] w-full object-cover" />
                    <p class="mt-1 text-center font-jua text-[clamp(0.5rem,1vw,0.65rem)] leading-tight text-haven-orange-bright">
                      {project.title}
                      <br />
                      {project.author}
                    </p>
                  </a>
                ))
              }
            </div>
            <p class="mt-3 text-center font-jua text-[clamp(0.7rem,1.3vw,0.9rem)] text-haven-orange-mid">
              follow workshops or create at your own pace &mdash; here are some cool projects at past hackathons!
            </p>
          </div>
        </div>
      </div>

      <div class="w-full self-end sm:w-[30rem] lg:-mt-6">
        <div class="rounded-[2rem] border-2 border-haven-yellow p-[clamp(0.4rem,1vw,0.6rem)]">
          <div class="rounded-[1.6rem] bg-white/80 px-[clamp(1rem,2.5vw,1.5rem)] py-[clamp(1.25rem,3vw,1.75rem)]">
            <h3 class="text-center font-darumadrop text-[clamp(1.35rem,2.6vw,1.9rem)] leading-[0.8] tracking-tight text-haven-orange-mid">
              Make Friends
            </h3>
            <div class="mt-3 grid grid-cols-3 gap-[clamp(0.4rem,1vw,0.6rem)]">
              {
                friendsPhotos.map((src) => (
                  <img src={src} alt="" class="aspect-[4/3] w-full rounded-[0.9rem] object-cover" />
                ))
              }
            </div>
            <p class="mt-3 text-center font-jua text-[clamp(0.7rem,1.3vw,0.9rem)] text-haven-orange-mid">
              meet new people and form relationships that will last a lifetime
            </p>
          </div>
        </div>
      </div>

      <div class="w-full self-start sm:w-[27rem] lg:-mt-6">
        <div class="rounded-[2rem] border-2 border-haven-yellow p-[clamp(0.4rem,1vw,0.6rem)]">
          <div class="rounded-[1.6rem] bg-white/80 px-[clamp(1rem,2.5vw,1.5rem)] py-[clamp(1.25rem,3vw,1.75rem)]">
            <h3 class="text-center font-darumadrop text-[clamp(1.35rem,2.6vw,1.9rem)] leading-[0.8] tracking-tight text-haven-orange-mid">
              Free Food and Prizes
            </h3>
            <div class="mt-3 grid grid-cols-3 gap-[clamp(0.4rem,1vw,0.6rem)]">
              {
                foodPhotos.map((src) => (
                  <img src={src} alt="" class="aspect-[4/3] w-full rounded-[0.9rem] object-cover" />
                ))
              }
            </div>
            <p class="mt-3 text-center font-jua text-[clamp(0.7rem,1.3vw,0.9rem)] text-haven-orange-mid">
              can&rsquo;t say no to free snacks :)
            </p>
          </div>
        </div>
      </div>
    </div>

    <div class="flex items-center justify-center gap-[clamp(0.5rem,2vw,1.5rem)]">
      <img
        src="/images/awesome-paws-left.png"
        alt=""
        class="pointer-events-none hidden w-[clamp(2rem,5vw,4rem)] shrink-0 sm:block"
      />
      <h3 class="text-center font-darumadrop text-[clamp(1.75rem,4.5vw,3.25rem)] leading-[0.85] tracking-tight text-white [text-shadow:0_0_10px_var(--color-haven-yellow)]">
        Don&rsquo;t game jams sound awesome?
      </h3>
      <img
        src="/images/awesome-paws-right.png"
        alt=""
        class="pointer-events-none hidden w-[clamp(2rem,5vw,4rem)] shrink-0 sm:block"
      />
    </div>

    <div class="relative mx-auto mt-[clamp(2rem,5vw,3rem)] flex w-full max-w-2xl flex-col gap-[clamp(1rem,2.5vw,1.5rem)]">
      <p class="self-end rounded-[1.75rem] bg-white px-[clamp(1.25rem,3vw,2rem)] py-[clamp(1rem,2.5vw,1.5rem)] text-center font-jua text-[clamp(0.85rem,1.7vw,1.15rem)] leading-relaxed text-haven-orange-deep sm:w-[85%]">
        This November, <span class="underline">we want YOU</span> to run a game jam. Yes, you! It doesn&rsquo;t matter
        if you have years of experience, or just learned what they are today.
      </p>
      <p class="self-start rounded-[1.75rem] bg-white px-[clamp(1.25rem,3vw,2rem)] py-[clamp(1rem,2.5vw,1.5rem)] text-center font-jua text-[clamp(0.85rem,1.7vw,1.15rem)] leading-relaxed text-haven-orange-deep sm:w-[85%]">
        You&rsquo;ll <span class="underline">join hundreds of teens</span> from around the world, all running hackathons
        in their own cities. Hack Club (a global nonprofit) will provide guides, funding, merch, and 1-on-1 mentorship!
      </p>
      <div class="relative self-end sm:w-[85%]">
        <p class="rounded-[1.75rem] bg-white px-[clamp(1.25rem,3vw,2rem)] py-[clamp(1rem,2.5vw,1.5rem)] text-center font-jua text-[clamp(0.85rem,1.7vw,1.15rem)] leading-relaxed text-haven-orange-deep">
          It may be challenging but this is your chance to
          <span class="underline">start something truly impactful</span>, learn real leadership skills, and make
          life-changing friendships along the way.
        </p>
        <img
          src="/images/speech-triangle.png"
          alt=""
          class="pointer-events-none absolute -right-6 top-1/2 hidden w-10 -translate-y-1/2 -rotate-[31deg] sm:block"
        />
      </div>
    </div>
  </div>
</section>
