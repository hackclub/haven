---
const steps = [
  { number: "1", label: "find a team of coorganizers", image: "/images/step-1.png" },
  { number: "2", label: "find a venue to host your hackathon", image: "/images/step-2.png" },
  { number: "3", label: "find sponsors to buy merch and prizes", image: "/images/step-3.png" },
  { number: "4", label: "buy supplies and prepare workshops", image: "/images/step-4.png" },
];
---

<section class="bg-haven-green px-[clamp(0.75rem,5.2vw,4.75rem)] pt-[clamp(1.5rem,4vw,3.5rem)] pb-[clamp(2rem,5vw,4.5rem)]">
  <h2
    class="mb-[clamp(1.25rem,3vw,2.5rem)] text-center font-darumadrop text-[clamp(1.1rem,3.5vw,3rem)] leading-[0.85] tracking-tight text-white [text-shadow:0_0_10px_var(--color-haven-yellow)]"
  >
    Here is how you can organize a game jam this November!
  </h2>

  <div class="grid grid-cols-2 gap-[clamp(0.5rem,1.5vw,1.35rem)] lg:grid-cols-4">
    {
      steps.map((step) => (
        <div class="flex flex-col gap-[clamp(0.5rem,1vw,0.9rem)] rounded-[clamp(0.875rem,2.1vw,1.875rem)] bg-[#ffe382] p-[clamp(0.75rem,1.8vw,1.5rem)]">
          <div class="flex items-start gap-[clamp(0.1rem,0.3vw,0.3rem)]">
            <span class="shrink-0 font-darumadrop text-[clamp(2rem,7.5vw,6.5rem)] leading-none tracking-tight text-haven-orange-bright">
              {step.number}
            </span>
            <p class="mt-[0.1em] font-darumadrop text-[clamp(0.75rem,2vw,1.6rem)] leading-[0.85] tracking-tight text-haven-orange-bright">
              {step.label}
            </p>
          </div>
          <img
            src={step.image}
            alt=""
            class="w-full rounded-[clamp(0.5rem,1.1vw,1rem)] object-cover"
            style="aspect-ratio: 239/172"
          />
        </div>
      ))
    }
  </div>
</section>
