---
import { steps, stepsCta, stepsHeading } from "../data/content";
---

<section class="relative z-10 pt-[clamp(2.5rem,6vw,5rem)] pb-[clamp(1.5rem,2vw,2rem)]">
  <div class="shell lg:w-[min(91.2%,109.44rem)] lg:max-w-none">
    <h2
      class="mx-auto max-w-[24ch] text-center font-display text-display text-white sm:max-w-none"
    >
      {stepsHeading}
    </h2>

    <ol
      class="mt-[clamp(1.5rem,3.5vw,3rem)] grid grid-cols-1 gap-[clamp(1rem,1.6vw,1.5rem)] sm:grid-cols-2 lg:grid-cols-4 lg:gap-[min(1.25vw,1.5rem)]"
    >
      {
        steps.map((step, i) => (
          <li class="flex flex-col gap-[clamp(1rem,1.6vw,1.5rem)] rounded-[1.875rem] bg-haven-butter p-[clamp(1.25rem,1.8vw,1.75rem)] lg:gap-[min(2.4vw,2.88rem)] lg:p-[min(2.63vw,3.15rem)]">
            <div class="flex items-start gap-[clamp(0.5rem,1vw,0.875rem)]">
              <span
                aria-hidden="true"
                class="font-display text-[clamp(3rem,5.5vw,5.625rem)] leading-[0.8] tracking-[-0.05em] text-haven-orange-bright lg:text-[min(4.4vw,5.28rem)]"
              >
                {i + 1}
              </span>
              <span class="font-display text-[clamp(1.15rem,1.9vw,1.875rem)] leading-[0.9] tracking-[-0.05em] text-haven-orange-bright lg:text-[min(1.53vw,1.84rem)]">
                {step.title}
              </span>
            </div>
            <img
              src={step.image}
              alt={step.alt}
              loading="lazy"
              decoding="async"
              width="239"
              height="172"
              class="mt-auto aspect-[239/172] w-full rounded-[1.25rem] object-cover"
            />
          </li>
        ))
      }
    </ol>

    <div class="mt-[clamp(1.5rem,3vw,2.5rem)] flex justify-center">
      <a
        href={stepsCta.href}
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-[clamp(0.5rem,1vw,0.75rem)] rounded-[1.25rem] bg-haven-butter px-[clamp(1.25rem,2.4vw,2.25rem)] py-[clamp(0.6rem,1.1vw,1rem)] font-display text-[clamp(1.15rem,1.9vw,1.875rem)] leading-none tracking-[-0.05em] text-haven-orange-bright transition-transform hover:scale-[1.04] active:scale-100"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="h-[0.85em] w-[0.85em] shrink-0"
        >
          <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" />
          <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" />
        </svg>
        {stepsCta.label}
      </a>
    </div>
  </div>
</section>
