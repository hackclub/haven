---
import { pastEvents, pastEventsHeading } from "../data/content";

const stage = [
  "md:absolute md:left-[9.2%] md:top-[31.2%] md:w-[25.8%]",
  "md:absolute md:left-[39.2%] md:top-[28.6%] md:w-[25.8%]",
  "md:absolute md:left-[68.6%] md:top-[26.1%] md:w-[25.8%]",
];
---

<section
  class="relative flex flex-col gap-[clamp(1rem,4vw,1.5rem)] px-5 pb-[clamp(3rem,8vw,6rem)] pt-[clamp(2rem,5vw,4rem)] md:contents"
>
  <h2
    class="mx-auto max-w-[42ch] -rotate-3 text-center font-display text-subheading text-white md:absolute md:left-[15.2%] md:top-[20%] md:w-[71.1%] md:max-w-none md:-rotate-4 md:text-[2.43cqw] md:leading-[0.9]"
  >
    {pastEventsHeading.map((line) => <span class="block">{line}</span>)}
  </h2>

  {
    pastEvents.map((item, i) => (
      <article
        class:list={[
          "polaroid mx-auto flex w-full max-w-[23rem] flex-col items-center gap-4 px-[clamp(1.25rem,2vw,2rem)] text-center md:mx-0 md:max-w-none",
          stage[i],
        ]}
      >
        <h3 class="font-display text-subheading text-white md:pt-4 md:text-[2.78cqw] md:leading-none">
          {item.title}
        </h3>

        <a
          href={item.href}
          target="_blank"
          rel="noopener"
          class="relative block w-full overflow-hidden rounded-[1.25rem] border-2 border-white md:rounded-[1.4cqw]"
        >
          <span class="sr-only">Watch the {item.title} video</span>
          <img
            src={item.image}
            alt={item.alt}
            loading="lazy"
            decoding="async"
            class:list={["aspect-[3/2] w-full object-cover", item.position]}
          />
          <img
            src={item.play}
            alt=""
            aria-hidden="true"
            width="72"
            height="65"
            class="pointer-events-none absolute top-1/2 left-1/2 w-[19%] -translate-x-1/2 -translate-y-1/2 -rotate-[40deg] select-none drop-shadow-[0_2px_6px_rgb(0_0_0/0.35)]"
          />
        </a>

        <p class="font-body text-copy text-white md:pb-6 md:text-[1.55cqw] md:leading-[1.05]">
          {item.caption}
        </p>
      </article>
    ))
  }
</section>
