---
const imgHavenBgTillInfo2 = "/images/haven-bg-till-info.png";
const imgHavenHeroBg = "/images/haven-hero-bg.png";
const imgPudHero1 = "/images/pud-hero-1.png";
const imgHeroBottom = "/images/hero-bottom.png";
const imgStickyTop = "/images/sticky-top.png";
const imgFlagStandaloneWtransparent1 = "/images/flag.png";
const imgHavenLogo = "/images/haven-logo.png";
const imgFriends3 = "/images/friends-3.png";
const imgFriends2 = "/images/friends-2.png";
const imgFriends1 = "/images/friends-1.png";
const imgProjects3 = "/images/projects-3.png";
const imgProjects2 = "/images/projects-2.png";
const imgProject1 = "/images/project-1.png";
const imgFood3 = "/images/food-3.png";
const imgFood2 = "/images/food-2.png";
const imgFood1 = "/images/food-1.png";
const imgHavenBottomBg1 = "/images/haven-bottom-bg.png";

const faqPositions = [
  { x: 48, y: 1928 },
  { x: 48, y: 2181.87 },
  { x: 48, y: 1978.81 },
  { x: 48, y: 2232.68 },
  { x: 48, y: 2029.61 },
  { x: 48, y: 2283.48 },
  { x: 48, y: 2080.42 },
  { x: 48, y: 2334.29 },
  { x: 48, y: 2131.22 },
  { x: 48, y: 2385.1 },
];
---

<div class="bg-[#b8c220] relative size-full" data-name="iPhone 17 - 1">
  <div class="absolute h-[1164px] left-0 top-[586px] w-[402px]" data-name="haven-bg-till-info 2">
    <img alt="" class="absolute inset-0 max-w-none object-cover pointer-events-none size-full" src={imgHavenBgTillInfo2} />
  </div>
  <div class="absolute h-[878px] left-[-161px] top-0 w-[645px]" data-name="haven-hero-bg">
    <div class="absolute inset-0 overflow-hidden pointer-events-none">
      <img alt="" class="absolute h-[410.01%] left-0 max-w-none top-0 w-[192.71%]" src={imgHavenHeroBg} />
    </div>
  </div>
  <div class="absolute contents left-0 top-[87px]" data-name="hero" id="top">
    <div class="-translate-x-1/2 [word-break:break-word] absolute font-['Jua'] h-[43px] leading-[0] left-[194px] not-italic text-[18px] text-center [text-shadow:0px_0px_4px_#ed5615] text-white top-[274px] tracking-[-0.54px] w-[306px] whitespace-pre-wrap">
      <p class="leading-none mb-0">Nov 14&ndash;15</p>
      <p class="leading-none">For teenagers around the world</p>
    </div>
    <p class="-translate-x-1/2 [word-break:break-word] absolute font-['Darumadrop_One'] h-[185px] leading-[0.8] left-[201.5px] not-italic text-[70px] text-center [text-shadow:0px_0px_4px_#ed5615] text-white top-[87px] tracking-[-3.5px] w-[369px] whitespace-pre-wrap">Lead&nbsp; a&nbsp; hackathon in&nbsp; your&nbsp; city!</p>
    <div class="absolute h-[149px] left-[30px] top-[721px] w-[204px]" data-name="pud-hero-1">
      <div class="absolute inset-0 overflow-hidden pointer-events-none">
        <img alt="" class="absolute h-[1329.87%] left-[-33.41%] max-w-none top-[-226.62%] w-[335.07%]" src={imgPudHero1} />
      </div>
    </div>
    <div class="absolute h-[143px] left-0 top-[804px] w-[403px]" data-name="hero-bottom">
      <div class="absolute inset-0 overflow-hidden pointer-events-none">
        <img alt="" class="absolute h-[817.56%] left-0 max-w-none top-[-156.29%] w-full" src={imgHeroBottom} />
      </div>
    </div>
  </div>
  <div class="absolute bg-white h-[214px] left-[35px] rounded-[30px] top-[370px] w-[333px]" data-name="vid-preview" />
  <div class="absolute contents left-[32px] top-[614px]" data-name="email" id="signup">
    <div class="absolute bg-white h-[36px] left-[32px] opacity-50 rounded-[30px] shadow-[0px_0px_8px_2px_rgba(250,104,27,0.65)] top-[631px] w-[338px]" data-name="email-field" />
    <div class="absolute bg-[#fa681b] h-[27px] left-[219px] rounded-[20px] top-[635px] w-[147px]" data-name="im-interested" />
    <a class="-translate-x-full -translate-y-1/2 [word-break:break-word] absolute flex flex-col font-['Jua'] h-[36px] justify-center leading-[0] left-[211px] not-italic text-[#ed5615] text-[20px] text-right top-[649px] tracking-[-0.6px] w-[179px]" href="mailto:you@gmail.com" target="_blank">
      <p class="cursor-pointer leading-none">you@email.com</p>
    </a>
    <div class="-translate-x-1/2 -translate-y-1/2 [word-break:break-word] absolute flex flex-col font-['Darumadrop_One'] h-[64px] justify-center leading-[0] left-[292.5px] not-italic text-[20px] text-center text-white top-[646px] tracking-[-0.6px] w-[147px]">
      <p class="leading-none">I&rsquo;m interested!</p>
    </div>
  </div>
  <div class="absolute contents left-[133px] top-0" data-name="sticky">
    <div class="absolute h-[77.692px] left-[208.64px] top-0 w-[192.911px]" data-name="sticky-top">
      <div class="absolute inset-0 overflow-hidden pointer-events-none">
        <img alt="" class="absolute h-[1574.08%] left-[-118.84%] max-w-none top-[-0.06%] w-[218.84%]" src={imgStickyTop} />
      </div>
    </div>
    <a href="#top" class="-translate-x-1/2 [word-break:break-word] absolute font-['Darumadrop_One'] h-[16.711px] leading-[1.1] left-[304.66px] not-italic text-[#ffd059] text-[12px] text-center top-[5.86px] tracking-[-0.36px] w-[43.684px]">
      Sign up
    </a>
    <a href="#about" class="-translate-x-1/2 [word-break:break-word] absolute font-['Darumadrop_One'] h-[16.711px] leading-[1.1] left-[344.53px] not-italic text-[#ffd059] text-[12px] text-center top-[5.86px] tracking-[-0.36px] w-[43.684px]">
      About
    </a>
    <a href="#faq" class="-translate-x-1/2 [word-break:break-word] absolute font-['Darumadrop_One'] h-[16.711px] leading-[1.1] left-[379.71px] not-italic text-[#ffd059] text-[12px] text-center top-[5.86px] tracking-[-0.36px] w-[43.684px]">
      FAQ
    </a>
    <div class="absolute h-[21.402px] left-[202.48px] top-[17.3px] w-[61.182px]" data-name="flag-standalone-wtransparent 1">
      <img alt="" class="absolute inset-0 max-w-none object-cover pointer-events-none size-full" src={imgFlagStandaloneWtransparent1} />
    </div>
    <div class="absolute h-[25.506px] left-[133px] top-[13.49px] w-[68.313px]" data-name="haven-logo">
      <div class="absolute inset-0 overflow-hidden pointer-events-none">
        <img alt="" class="absolute h-[455.22%] left-[-64.29%] max-w-none top-[-190.43%] w-[233.77%]" src={imgHavenLogo} />
      </div>
    </div>
  </div>
  <div class="absolute contents left-[26px] top-[1225.55px]" data-name="friends">
    <div class="absolute bg-white h-[133.685px] left-[26px] opacity-80 rounded-[15.978px] top-[1225.55px] w-[350.456px]" data-name="friends-box" />
    <p class="-translate-x-1/2 [word-break:break-word] absolute font-['Jua'] h-[13px] leading-none left-[201.5px] not-italic text-[#fc8616] text-[12px] text-center top-[1265.55px] tracking-[-0.36px] w-[323px]">
      meet new people, who may become your friends for life!
    </p>
    <p class="-translate-x-1/2 [word-break:break-word] absolute font-['Darumadrop_One'] h-[29.293px] leading-[0.8] left-[200.96px] not-italic text-[#fc8616] text-[25px] text-center top-[1236.74px] tracking-[-1.25px] w-[218.902px]">
      Make friends
    </p>
    <div class="absolute h-[63.913px] left-[252.89px] rounded-[10.652px] top-[1283.61px] w-[109.717px]" data-name="friends-3">
      <div class="absolute inset-0 overflow-hidden pointer-events-none rounded-[10.652px]">
        <img alt="" class="absolute h-[167.5%] left-[-18.45%] max-w-none top-[-38.13%] w-[130.1%]" src={imgFriends3} />
      </div>
    </div>
    <div class="absolute h-[63.913px] left-[152.76px] rounded-[10.652px] top-[1283.61px] w-[92.674px]" data-name="friends-2">
      <img alt="" class="absolute inset-0 max-w-none object-cover pointer-events-none rounded-[10.652px] size-full" src={imgFriends2} />
    </div>
    <div class="absolute h-[63.913px] left-[39.32px] rounded-[10.652px] top-[1283.61px] w-[105.457px]" data-name="friends-1">
      <img alt="" class="absolute inset-0 max-w-none object-cover pointer-events-none rounded-[10.652px] size-full" src={imgFriends1} />
    </div>
  </div>
  <div class="absolute contents left-[26px] top-[1023px]" data-name="projects">
    <div class="absolute bg-white h-[185px] left-[26px] opacity-80 rounded-[22.346px] top-[1023px] w-[348px]" data-name="projects-box" />
    <div class="-translate-x-1/2 [word-break:break-word] absolute font-['Jua'] h-[26px] leading-[0] left-[200.5px] not-italic text-[#fc8616] text-[12px] text-center top-[1062px] tracking-[-0.36px] w-[319px]">
      <p class="leading-none mb-0">follow workshops or create at your own pace</p>
      <p class="leading-none">here are some cool projects at past hackathons!</p>
    </div>
    <p class="-translate-x-1/2 [word-break:break-word] absolute font-['Darumadrop_One'] h-[27px] leading-[0.8] left-[197px] not-italic text-[#fc8616] text-[25px] text-center top-[1035px] tracking-[-1.25px] w-[306px]">
      Learn and build projects
    </p>
    <div class="absolute h-[87.893px] left-[260.33px] rounded-[14.897px] top-[1102.09px] w-[96.086px]" data-name="projects-3">
      <div class="absolute inset-0 overflow-hidden pointer-events-none rounded-[14.897px]">
        <img alt="" class="absolute h-[122.88%] left-[-0.08%] max-w-none top-0 w-[100.17%]" src={imgProjects3} />
      </div>
    </div>
    <div class="absolute h-[87.893px] left-[151.58px] rounded-[14.897px] top-[1102.09px] w-[96.831px]" data-name="projects-2">
      <div class="absolute inset-0 overflow-hidden pointer-events-none rounded-[14.897px]">
        <img alt="" class="absolute h-[117.8%] left-[-0.03%] max-w-none top-0 w-[100.07%]" src={imgProjects2} />
      </div>
    </div>
    <div class="absolute h-[87.741px] left-[42.84px] rounded-[14.897px] top-[1102.09px] w-[96.253px]" data-name="project-1">
      <div class="absolute inset-0 overflow-hidden pointer-events-none rounded-[14.897px]">
        <img alt="" class="absolute h-[129.85%] left-[-0.14%] max-w-none top-0 w-[100.27%]" src={imgProject1} />
      </div>
    </div>
  </div>
  <p class="[word-break:break-word] absolute font-['Jua'] h-[65.027px] leading-none left-[81.68px] not-italic text-[15.337px] text-white top-[948.74px] tracking-[-0.4601px] w-[209.805px]">
    A social coding event where you lock in on a project (ex: a game or app) with friends + food!
  </p>
  <p class="[word-break:break-word] absolute font-['Darumadrop_One'] h-[33.741px] leading-[0.8] left-[78px] not-italic text-[26.993px] text-white top-[915px] tracking-[-1.3496px] w-[246px]" id="about">
    What is a hackathon?
  </p>
  <div class="absolute contents left-[26px] top-[1375.55px]" data-name="food">
    <div class="absolute bg-white h-[142.934px] left-[26px] opacity-80 rounded-[17.867px] top-[1375.55px] w-[349.593px]" data-name="food-box" />
    <p class="-translate-x-1/2 [word-break:break-word] absolute font-['Jua'] font-normal h-[25.609px] leading-none left-[200.8px] text-[#fc8616] text-[12px] text-center top-[1415.45px] tracking-[-0.36px] w-[255.495px]" style={`font-variation-settings: "CTGR" 0, "wdth" 100;`}>
      can&rsquo;t say no to free snacks :)
    </p>
    <p class="-translate-x-1/2 [word-break:break-word] absolute font-['Darumadrop_One'] h-[32.756px] leading-[0.8] left-[200.8px] not-italic text-[#fc8616] text-[25px] text-center top-[1388.06px] tracking-[-1.25px] w-[282.89px]">
      Enjoy free food and prizes
    </p>
    <div class="absolute h-[69.085px] left-[251.72px] rounded-[11.911px] top-[1433.92px] w-[108.987px]" data-name="food-3">
      <div class="absolute inset-0 overflow-hidden pointer-events-none rounded-[11.911px]">
        <img alt="" class="absolute h-[149.13%] left-[-22.32%] max-w-none top-[-28.08%] w-[141.78%]" src={imgFood3} />
      </div>
    </div>
    <div class="absolute h-[69.085px] left-[152.26px] rounded-[11.911px] top-[1433.92px] w-[92.312px]" data-name="food-2">
      <img alt="" class="absolute inset-0 max-w-none object-cover pointer-events-none rounded-[11.911px] size-full" src={imgFood2} />
    </div>
    <div class="absolute h-[69.085px] left-[39.7px] rounded-[11.911px] top-[1433.92px] w-[104.818px]" data-name="food-1">
      <div class="absolute inset-0 overflow-hidden pointer-events-none rounded-[11.911px]">
        <img alt="" class="absolute h-[141.4%] left-[-18.75%] max-w-none top-[-19.55%] w-[139.77%]" src={imgFood1} />
      </div>
    </div>
  </div>
  <div class="absolute contents left-[-203px] top-[1728px]" data-name="faq" id="faq">
    <div class="absolute h-[1035.465px] left-[-203px] top-[1728px] w-[800.36px]" data-name="haven-bottom-bg 1">
      <div class="absolute inset-0 overflow-hidden pointer-events-none">
        <img alt="" class="absolute h-[228.94%] left-0 max-w-none top-[-128.8%] w-full" src={imgHavenBottomBg1} />
      </div>
    </div>
    {faqPositions.map((pos) => (
      <div class="absolute contents" style={`left: ${pos.x}px; top: ${pos.y}px;`}>
        <div
          class="absolute bg-white h-[41.84px] rounded-[12.203px] w-[306px]"
          style={`left: ${pos.x}px; top: ${pos.y}px;`}
        />
        <div
          class="-translate-y-1/2 [word-break:break-word] absolute flex flex-col font-['Darumadrop_One'] h-[19.736px] justify-center leading-[0] not-italic text-[#ed5615] text-[18.305px] tracking-[-0.9153px] w-[143.877px]"
          style={`left: ${pos.x + 18.25}px; top: ${pos.y + 20.92}px;`}
        >
          <p class="leading-[0.8]">Am I eligible?</p>
        </div>
      </div>
    ))}
    <p class="-translate-x-1/2 [word-break:break-word] absolute font-['Darumadrop_One'] h-[67.513px] leading-[0.8] left-[196.91px] not-italic text-[#ed5615] text-[55.581px] text-center top-[1812.36px] tracking-[-2.779px] w-[170.417px]">
      FAQ
    </p>
  </div>
</div>
