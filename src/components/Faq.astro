---
import { faqs } from "../data/content";
import type { FaqItem } from "../data/types";

interface Props {
  items?: FaqItem[];
}

const { items = faqs } = Astro.props;

const columns = [
  items.filter((_, i) => i % 2 === 0),
  items.filter((_, i) => i % 2 === 1),
];
---

<section
  id="faq"
  class="scene-harvest relative pb-[clamp(3rem,7vw,6rem)] pt-[clamp(3.5rem,11vw,7.875rem)] md:py-0"
>
  <div class="shell md:contents">
    <h2
      class="text-center font-display text-[clamp(3.5rem,8vw,6.25rem)] leading-[0.8] tracking-[-0.05em] text-haven-orange-deep md:absolute md:inset-x-0 md:top-[11.5cqw] md:text-[6.94cqw]"
    >
      FAQ
    </h2>

    <div
      class="mx-auto mt-[16vw] grid max-w-[68rem] grid-cols-1 items-start gap-x-[clamp(1rem,2vw,1.75rem)] gap-y-[clamp(0.75rem,1.5vw,1.25rem)] md:grid-cols-2 md:absolute md:left-[5.65%] md:mt-0 md:w-[88.7%] md:max-w-none md:top-[30.5cqw] md:gap-x-[21.49%] md:gap-y-[1.1cqw]"
    >
      {
        columns.map((column) => (
          <ul class="flex flex-col gap-[clamp(0.75rem,1.5vw,1.25rem)] md:gap-[1.1cqw]">
            {column.map((item) => (
              <li>

                <details class="group rounded-[1.25rem] bg-white/85 md:rounded-[1.4cqw]">
                  <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-[clamp(1rem,2vw,1.875rem)] py-[clamp(0.75rem,1.2vw,1.1rem)] font-display text-[clamp(1.125rem,1.9vw,1.875rem)] leading-[0.9] tracking-[-0.05em] text-haven-orange-deep group-open:pb-2.5 md:px-[2cqw] md:py-[1.9cqw] md:text-[1.9cqw] md:group-open:pb-[0.9cqw] [&::-webkit-details-marker]:hidden">
                    {item.q}
                    <img
                      src="/images/faq-chevron.webp"
                      alt=""
                      aria-hidden="true"
                      width="416"
                      height="256"
                      class="w-[clamp(1.125rem,1.6vw,1.875rem)] shrink-0 transition-transform transition-ease-in-out duration-200 group-open:rotate-180 md:w-[1.6cqw]"
                    />
                  </summary>
                  <p class="px-[clamp(1rem,2vw,1.875rem)] pb-[clamp(0.75rem,1.2vw,1.1rem)] font-body text-[clamp(0.875rem,1.15vw,1.25rem)] leading-[1.25] tracking-[-0.03em] text-haven-orange-deep md:px-[2cqw] md:pb-[1.9cqw] md:text-[1.15cqw]">
                    {item.a.map((seg) =>
                      seg.href ? (
                        <a
                          href={seg.href}
                          class="underline decoration-from-font underline-offset-2 hover:text-haven-orange-mid"
                          {...(seg.href.startsWith("http")
                            ? { target: "_blank", rel: "noopener" }
                            : {})}
                        >
                          {seg.text}
                        </a>
                      ) : (
                        seg.text
                      ),
                    )}
                  </p>
                </details>
              </li>
            ))}
          </ul>
        ))
      }
    </div>

    <a
      href="#top"
      class="mx-auto mt-[clamp(2.5rem,6vw,5rem)] block w-[50%] rounded-[1.875rem] bg-haven-green-deep shadow-[0_0_10px_var(--color-haven-green-deep)] px-6 py-[clamp(1.25rem,2.5vw,2.25rem)] text-center font-display text-[clamp(1.5rem,4vw,2.5rem)] leading-none tracking-[-0.03em] text-white transition-transform hover:scale-[1.02] active:scale-100 md:mt-[clamp(2.5rem,6vw,5rem)] md:absolute md:left-1/2  md:w-[25%] md:max-w-none md:-translate-x-1/2 md:top-[86cqw] md:rounded-[2.1cqw] md:py-[1.5cqw] md:text-[clamp(1.5rem,3vw,2.5rem)]"
    >
      Sign up!
    </a>
  </div>
</section>
