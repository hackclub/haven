---
const navLinks = [
  { label: "Sign up", href: "#signup" },
  { label: "About", href: "#about" },
  { label: "FAQ", href: "#faq" },
];
---

<section
  id="hero"
  class="relative isolate overflow-hidden bg-haven-green"
>
  <div class="relative flex h-[100svh] flex-col overflow-hidden bg-haven-green">
    <img
      src="/images/haven-hero-bg.png"
      alt=""
      class="absolute inset-0 h-full w-full object-cover object-top"
    />
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-[clamp(0.5rem,1.4vw,1.5rem)] z-10 rounded-[clamp(14px,2vw,32px)] border-2 border-haven-yellow/90 sm:border-[3px]"
    >
    </div>

    <header class="relative z-20 h-[clamp(4.5rem,9vw,10rem)]">
      <img
        src="/images/haven-logo-final.png"
        alt="Hack Club Haven"
        class="absolute left-1/2 top-[clamp(1.5rem,3.2vw,3.75rem)] h-[clamp(3.5rem,7.2vw,8.5rem)] w-auto -translate-x-1/2"
      />
      <nav class="absolute right-[clamp(2.5rem,6vw,6.5rem)] top-[clamp(1.75rem,3.6vw,4.25rem)] flex max-w-[48%] flex-wrap justify-end gap-x-[clamp(0.75rem,2.2vw,2.5rem)] gap-y-1 font-darumadrop text-[clamp(0.8rem,2.2vw,2.25rem)] text-haven-yellow">
        {
          navLinks.map((link) => (
            <a
              href={link.href}
              class="inline-block whitespace-nowrap transition-transform duration-200 ease-out hover:-translate-y-1 hover:scale-110 hover:text-white"
            >
              {link.label}
            </a>
          ))
        }
      </nav>
    </header>

    <div class="relative z-10 mx-auto flex w-full max-w-[100rem] flex-1 flex-col items-center justify-center px-[clamp(1rem,4vw,3rem)] text-center">
      <h1 class="w-full text-[clamp(2.25rem,8.3vw,10rem)] font-darumadrop leading-[0.85] tracking-tight text-white [text-shadow:0_0_10px_var(--color-haven-orange-deep)]">
        Lead a game jam<br /> in your city!
      </h1>
      <p class="mt-[clamp(0.5rem,1.4vw,1.5rem)] w-full text-[clamp(0.95rem,2.8vw,2.75rem)] font-jua text-white [text-shadow:0_0_6px_var(--color-haven-orange-deep)]">
        Nov 14&ndash;15 &#9825; For teenagers around the world
      </p>

      <form class="relative mt-[clamp(1.25rem,3vw,3rem)] w-[min(92%,50rem)]">
        <input
          type="email"
          required
          placeholder="enter email to sign up"
          class="w-full rounded-full bg-white/70 py-[clamp(0.7rem,2vw,1.75rem)] pl-[clamp(1rem,2.2vw,2.25rem)] pr-[clamp(2.75rem,7vw,6rem)] font-jua text-[clamp(1rem,3.2vw,2.75rem)] text-haven-orange-deep shadow-[0_0_10px_3px_rgba(250,104,27,0.55)] outline-none placeholder:text-haven-orange-deep"
        />
        <button
          type="submit"
          aria-label="Sign up"
          class="absolute right-[clamp(0.3rem,0.8vw,0.75rem)] top-1/2 flex size-[clamp(2.25rem,5.2vw,4.5rem)] -translate-y-1/2 items-center justify-center rounded-full bg-haven-orange-bright"
        >
          <img src="/images/haven-sign-up-arrow.png" alt="" class="h-[45%] w-auto" />
        </button>
      </form>
    </div>

    <a
      href="#more-info"
      class="absolute bottom-[clamp(1.5rem,4vw,4rem)] left-1/2 z-10 flex -translate-x-1/2 flex-col items-center gap-1 text-white/50"
    >
      <span class="font-jua text-[clamp(0.85rem,2.4vw,2.25rem)]">more info</span>
      <img src="/images/triangle-down.svg" alt="" class="mt-1 h-[clamp(1.4rem,3.6vw,3.25rem)] w-[clamp(4rem,10.5vw,9.5rem)] -scale-y-100" />
    </a>

    <div
      id="video-widget"
      class="absolute bottom-[clamp(1.5rem,4vw,4rem)] right-[clamp(0.75rem,3vw,3.5rem)] z-10 w-[clamp(7rem,22vw,28rem)] rounded-2xl bg-white p-[clamp(0.4rem,1.2vw,1.2rem)] shadow-lg"
    >
      <button
        type="button"
        id="video-fold-toggle"
        aria-expanded="true"
        class="flex w-full cursor-pointer items-center justify-between px-1 pb-1"
      >
        <span id="video-fold-label" class="font-jua text-[clamp(0.5rem,1.3vw,1.4rem)] text-haven-orange-mid">close video</span>
        <img id="video-fold-chevron" src="/images/small-arrow.png" alt="" class="h-[clamp(0.45rem,1.1vw,1.2rem)] w-auto transition-transform" />
      </button>
      <div id="video-body">
        <div
          id="video-trigger"
          role="button"
          tabindex="0"
          aria-haspopup="dialog"
          aria-label="Expand Haven intro video"
          class="cursor-pointer"
        >
          <div class="aspect-video w-full overflow-hidden rounded-lg border-2 border-sky-400 bg-black sm:rounded-xl">
            <iframe
              id="video-preview-iframe"
              class="h-full w-full border-0"
              src="https://www.youtube.com/embed/AnG56HUDzdI?autoplay=1&mute=1&loop=1&playlist=AnG56HUDzdI&modestbranding=1&playsinline=1&rel=0"
              title="Haven intro video preview"
              allow="autoplay; encrypted-media"
            ></iframe>
          </div>
          <p class="mt-1 text-center font-jua text-[clamp(0.4rem,1vw,0.85rem)] text-gray-400">(click to expand)</p>
        </div>
      </div>
    </div>

    <img
      src="/images/pud-hero-1.png"
      alt=""
      class="pointer-events-none absolute bottom-0 left-0 z-10 -ml-3 w-[clamp(8rem,22vw,27rem)] sm:-ml-4"
    />
  </div>
</section>

<img
  src="/images/hero-bottom.png"
  alt=""
  class="pointer-events-none relative z-10 mt-[-14.5%] w-full"
/>

<div
  id="video-modal"
  role="dialog"
  aria-modal="true"
  aria-label="Haven intro video"
  class="fixed inset-0 z-50 hidden items-center justify-center bg-black/80 p-4 sm:p-8"
>
  <div class="relative w-full max-w-4xl">
    <button
      type="button"
      id="video-close"
      aria-label="Close video"
      class="absolute -top-10 right-0 flex size-8 items-center justify-center rounded-full bg-white text-lg font-bold text-haven-orange-deep sm:-top-12 sm:size-10"
    >
      &#10005;
    </button>
    <div class="aspect-video w-full overflow-hidden rounded-2xl shadow-2xl">
      <iframe
        id="video-iframe"
        class="h-full w-full border-0"
        src="about:blank"
        title="Haven intro video"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
        allowfullscreen
      ></iframe>
    </div>
  </div>
</div>

<script>
  // @ts-nocheck
  const YOUTUBE_ID = "AnG56HUDzdI";

  const trigger = document.getElementById("video-trigger");
  const modal = document.getElementById("video-modal");
  const closeBtn = document.getElementById("video-close");
  const iframe = document.getElementById("video-iframe");

  const foldToggle = document.getElementById("video-fold-toggle");
  const videoBody = document.getElementById("video-body");
  const foldLabel = document.getElementById("video-fold-label");
  const foldChevron = document.getElementById("video-fold-chevron");
  const previewIframe = document.getElementById("video-preview-iframe");
  const PREVIEW_SRC = `https://www.youtube.com/embed/${YOUTUBE_ID}?autoplay=1&mute=1&loop=1&playlist=${YOUTUBE_ID}&modestbranding=1&playsinline=1&rel=0`;

  let folded = false;

  function setFolded(next) {
    folded = next;
    if (videoBody) videoBody.style.display = folded ? "none" : "";
    if (foldLabel) foldLabel.textContent = folded ? "open video" : "close video";
    foldChevron?.classList.toggle("-scale-y-100", folded);
    foldToggle?.setAttribute("aria-expanded", String(!folded));
    // Hiding the iframe alone doesn't stop it — it keeps decoding/playing offscreen.
    // Drop the src to actually stop it, and restore it (restarting the loop) on unfold.
    if (previewIframe) previewIframe.src = folded ? "about:blank" : PREVIEW_SRC;
  }

  foldToggle?.addEventListener("click", () => setFolded(!folded));

  function openVideo() {
    if (iframe) iframe.src = `https://www.youtube.com/embed/${YOUTUBE_ID}?autoplay=1`;
    modal?.classList.remove("hidden");
    modal?.classList.add("flex");
    document.body.style.overflow = "hidden";
  }

  function closeVideo() {
    modal?.classList.add("hidden");
    modal?.classList.remove("flex");
    if (iframe) iframe.src = "about:blank";
    document.body.style.overflow = "";
  }

  trigger?.addEventListener("click", openVideo);
  trigger?.addEventListener("keydown", (e) => {
    if (e.key === "Enter" || e.key === " ") {
      e.preventDefault();
      openVideo();
    }
  });
  closeBtn?.addEventListener("click", closeVideo);
  modal?.addEventListener("click", (e) => {
    if (e.target === modal) closeVideo();
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeVideo();
  });
</script>
