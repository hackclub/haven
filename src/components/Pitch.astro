---
import { pitchHeading, pitches } from "../data/content";

const toStyle = (vars: Record<string, string>) =>
  Object.entries(vars)
    .map(([key, value]) => `${key}:${value}`)
    .join(";");

const stage: Record<string, string> = {
  triangles: "md:absolute md:left-[24.9%] md:top-[60.6%] md:w-[53.3%]",
  heading: "md:absolute md:left-[28.2%] md:top-[64%] md:w-[46.2%]",
};

const BUBBLE_WIDTH = "md:w-[66.7%] md:self-start";
const bubbleOffset: Record<string, string> = {
  invite: "md:ml-[33.3%]",
  support: "md:ml-0",
  impact: "md:ml-[4.78%]",
};

const alignment = {
  start: "sm:self-start",
  center: "sm:self-center",
  end: "sm:self-end",
} as const;
---

<section
  class="relative flex flex-col items-stretch gap-[clamp(1.5rem,3vw,2.5rem)] px-5 pb-[clamp(2rem,5vw,4rem)] pt-[clamp(2.5rem,6vw,5rem)] md:contents"
>
  <img
    src="/images/banner-triangles.webp"
    alt=""
    aria-hidden="true"
    width="952"
    height="248"
    class={`pointer-events-none hidden select-none md:block ${stage.triangles}`}
  />

  <h2
    class:list={[
      "glow-yellow mx-auto max-w-[14ch] text-center font-display text-display text-white md:max-w-none md:text-[4.17cqw] md:leading-[0.8]",
      stage.heading,
    ]}
  >
    {pitchHeading}
  </h2>

  <div
    class="contents md:absolute md:left-[13.26%] md:top-[72%] md:flex md:w-[61.11%] md:flex-col md:gap-[2.83cqw]"
  >
    {
      pitches.map((pitch) => (
        <div
          class:list={[
            "speech w-full max-w-[38rem] md:max-w-none",
            alignment[pitch.align],
            BUBBLE_WIDTH,
            bubbleOffset[pitch.id],
          ]}
          style={pitch.tail ? toStyle(pitch.tail) : undefined}
        >
          <p class="px-[clamp(1.25rem,3vw,2.5rem)] py-[clamp(1.1rem,2.2vw,1.75rem)] text-center font-body text-copy leading-[1.7] text-haven-orange-deep md:px-[6%] md:py-[3.3%] md:text-[1.55cqw] md:leading-[1.3]">
            {pitch.body.map((segment) =>
              segment.mark ? <span class="marker">{segment.text}</span> : segment.text,
            )}
          </p>
        </div>
      ))
    }
  </div>
</section>
