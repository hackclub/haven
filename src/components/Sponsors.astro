---
import type { Sponsor } from "../data/types";

interface Props {
  heading: string;
  items: Sponsor[];
}

const { heading, items } = Astro.props;

const ROW_SIZE = 3;
const rows: Sponsor[][] = [];
for (let i = 0; i < items.length; i += ROW_SIZE) {
  rows.push(items.slice(i, i + ROW_SIZE));
}
---

{
  items.length > 0 && (
    <section class="relative z-10 bg-haven-green">
      <img
        src="/images/sponsors/map-edge.png"
        class="absolute top-0 w-full object-cover -translate-y-3/4 md:-translate-y-1/2"
      />
      <div class="pt-[clamp(2rem,6vw,10rem)]">
        <div class="grid grid-cols-[1fr_auto_1fr] items-center h-[clamp(2rem,7vw,5rem)] gap-[clamp(1rem,8vw,8rem)] pt-4 relative">
          <img
            src="/images/sponsors/houses-1-l.png"
            class="h-[clamp(2rem,7vw,5rem)] object-contain justify-self-end"
          />
          <img
            src="/images/sponsors/top-house.png"
            class="h-[clamp(2rem,7vw,5rem)] object-contain justify-self-center"
          />
          <img
            src="/images/sponsors/houses-1-r.png"
            class="h-[clamp(2rem,7vw,5rem)] object-contain justify-self-start"
          />
        </div>
        <div class="shell">
          <h2 class="text-center z-25 font-display text-display text-white translate-y-[clamp(1rem,2vw,2rem)]">
            {heading}
          </h2>

          {rows.map((row, rowIndex) => (
            <div class="relative mx-auto mt-8 md:mt-[clamp(0.5rem,5vw,6rem)] max-w-[80rem]">
              <img
                src={
                  rowIndex === 0
                    ? "/images/sponsors/brown-box-xl.png"
                    : "/images/sponsors/brown-box-tall.png"
                }
                class:list={["pointer-events-none absolute left-1/2 top-0 -z-10 w-[clamp(5rem,80vw,80rem)] -translate-x-1/2 -translate-y-3/8 md:-translate-y-1/3 object-contain ",
                  rowIndex === 0 ? "mt-0" : "mt-[clamp(4rem,6vw,8rem)] md:mt-[clamp(8rem,15vw,15rem)]"
                ]}
              />
              <img
                src="/images/sponsors/lil-brown-trail.png"
                class:list={["pointer-events-none absolute left-1/2 top-0 -z-10 w-[clamp(8rem,10vw,15rem)] -translate-x-1/2 -translate-y-1/2 md:-translate-y-[clamp(2rem,6rem-3vw,6rem)] object-contain",
                  rowIndex === 0 ? "hidden" : "block"
                ]}
              />
              <ul class="flex items-center gap-[clamp(0rem,8vw,5rem)] px-[clamp(2rem,15vw,15rem)]">
                {row.map((item) => (
                  <li class:list={["w-full flex flex-col items-center text-center translate-y-[clamp(0rem,vw,2rem)] ",
                  rowIndex === 0 ? "mt-0" : "mt-[clamp(3rem,12vw,12rem)]"]}>
                    <a
                      href={item.href}
                      target="_blank"
                      rel="noopener"
                      class="block transition-transform hover:scale-[1.02] active:scale-100"
                    >
                      <img
                        src={item.image}
                        alt={item.name}
                        loading="lazy"
                        decoding="async"
                        class="mx-auto max-h-[clamp(5rem,12vw,12rem)] w-full object-contain"
                      />
                      <p class="text-white md:text-[clamp(0.875rem,3vw,2rem)] md:leading-[1.05] md:pt-4">
                        {item.name}
                      </p>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>
  )
}