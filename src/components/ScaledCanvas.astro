---
interface Props {
  width: number;
  height: number;
  class?: string;
}

const { width, height, class: className = "" } = Astro.props;
const ratio = `${width} / ${height}`;
---

<div class={`relative w-full overflow-hidden ${className}`} style={`aspect-ratio: ${ratio}`}>
  <div
    class="absolute top-0 left-0 origin-top-left"
    style={`width: ${width}px; height: ${height}px; transform: scale(calc(100vw / ${width}px));`}
  >
    <slot />
  </div>
</div>
