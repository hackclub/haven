---
import { about, perks } from "../data/content";

const stage: Record<string, string> = {
  intro: "md:absolute md:left-[16.1%] md:top-[5.6%] md:w-[30%]",
  daven: "md:absolute md:left-[65.8%] md:top-[5.6%] md:w-[7.5%]",
  build: "md:absolute md:left-[4.8%] md:top-[17.1%] md:w-[39%]",
  friends: "md:absolute md:left-[45%] md:top-[23%] md:w-[41.7%]",
  food: "md:absolute md:left-[10.6%] md:top-[42%] md:w-[42.4%]",
};
---

<section
  class="relative flex flex-col gap-[clamp(1.5rem,4vw,3rem)] px-18 pb-[clamp(3rem,7vw,6rem)] pt-[max(3.5rem,14vw)] sm:px-24 md:contents"
>
  <div
    class={`panel shadow-[0_0_5px_var(--color-haven-yellow)] w-full max-w-[40rem] self-center px-[clamp(1rem,2.5vw,2.5rem)] py-[clamp(1.25rem,2.2vw,1.75rem)] text-center md:shadow-none md:self-start md:max-w-[42rem] md:bg-transparent md:p-0 md:text-left ${stage.intro}`}
  >
    <h2
      class="font-display text-heading text-haven-orange-mid md:text-[3cqw] md:leading-[0.8] md:text-white"
    >
      {about.title}
    </h2>
    <p
      class="mt-[1em] font-body text-lead leading-[1.15] text-haven-orange-mid md:text-[1.5cqw] md:text-white"
    >
      {about.body}
    </p>
  </div>

  <img
    src="/images/daven.webp"
    alt=""
    aria-hidden="true"
    width="108"
    height="108"
    class={`hidden select-none md:block ${stage.daven}`}
  />

  {
    perks.map((perk) => (
      <div
        class:list={[
          "w-full max-w-[40rem] md:max-w-none md:p-[2.1%]",
          perk.side === "end" ? "self-end" : "self-start",
          stage[perk.id],
        ]}
      >
        <div class="panel px-[clamp(2rem,5vw,5rem)] py-[clamp(1.25rem,2.2vw,1.75rem)] text-center md:px-[6%] md:py-[4%]">
          <h3 class="font-display text-heading text-haven-orange-mid md:text-[3.06cqw] md:leading-[0.8]">
            {perk.title}
          </h3>

          <ul class="p-2 mt-[clamp(0.75rem,1.6vw,1.25rem)] grid grid-cols-2 gap-[clamp(0.5rem,1.2vw,1rem)] md:mt-[4%] md:gap-[3%]">
            {perk.photos.map((photo) => {
              const Cell = photo.href ? "a" : "div";
              return (
                <li>
                  <Cell
                    {...(photo.href
                      ? { href: photo.href, target: "_blank", rel: "noopener" }
                      : {})}
                    class:list={["block", photo.href && "group"]}
                  >
                    <img
                      src={photo.src}
                      alt={photo.alt}
                      loading="lazy"
                      decoding="async"
                      class:list={[
                        "w-full rounded-[clamp(0.625rem,1vw,1rem)] object-cover transition-transform md:rounded-[1cqw]",
                        photo.href && "group-hover:scale-[1.03]",
                        perk.aspect,
                        photo.position,
                      ]}
                    />
                    {photo.caption && (
                      <span class="mt-1.5 block font-body text-[clamp(0.8125rem,1.1vw,1rem)] leading-[clamp(0.8rem,1.2vw,1.5rem)] tracking-[-0.03em] text-haven-gold md:mt-[3%] md:text-[1.11cqw]">
                        <span class="block">{photo.caption.title}</span>
                        <span class="block text-[0.9em]">
                          {photo.caption.author}
                        </span>
                      </span>
                    )}
                  </Cell>
                </li>
              );
            })}
          </ul>

          {perk.blurb.map((line) => (
            <p class="mt-1 font-body text-copy text-haven-orange-mid md:text-[1.4cqw] md:leading-[1.15]">
              {line}
            </p>
          ))}
        </div>
      </div>
    ))
  }
</section>
